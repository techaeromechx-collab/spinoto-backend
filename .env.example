# Copy this file to .env and edit values for your local setup.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated. Add the booking landing page here or its fetches are blocked.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://booking.spinoto.com

# Database
DATABASE_URL=postgres://raju@localhost:5432/spinoto

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ─── Booking integration (booking.spinoto.com) ───────────────────────────────

# Shared secret for the machine-to-machine webhook
# POST /api/integrations/booking-orders (x-api-key header).
# The endpoint fails closed with 503 while this is unset. Never reuse this
# value for anything else.
BOOKING_WEBHOOK_KEY=

# Razorpay. Leave BOTH blank to run the booking flow in simulated-payment mode:
# create-order then returns key_id 'rzp_test_mock' and the SPA runs its fake
# checkout, so the whole funnel is testable before the merchant account exists.
# ⚠ RAZORPAY_KEY_SECRET must NEVER be sent to a browser. Only key_id is public.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OTP delivery. A generic outbound webhook, so any SMS vendor plugs in without
# a code change; it receives { mobile, message, template }.
# ⚠ While this is unset, EVERY OTP is the fixed code below and anyone can
#   verify any mobile number. Set it before taking real bookings.
SMS_WEBHOOK_URL=
BOOKING_OTP_FIXED=1234
BOOKING_OTP_TTL_MIN=10
BOOKING_OTP_MAX_ATTEMPTS=5

# How long the post-OTP booking_token stays valid (zeit/ms format).
BOOKING_TOKEN_TTL=30m

# Serviceability gate for GET /api/public/booking/check-location.
# Comma-separated pincode PREFIXES, e.g. "38,39". Leave blank to accept every
# location — the hubs table carries no coordinates yet, so a radius check is
# not possible and this prefix list is the only gate available.
BOOKING_SERVICE_PINCODES=
