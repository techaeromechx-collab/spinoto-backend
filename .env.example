# Copy this file to .env and edit values for your local setup.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated. Add the booking landing page here or its fetches are blocked.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://booking.spinoto.com

# Database
DATABASE_URL=postgres://raju@localhost:5432/spinoto

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ─── Booking integration (booking.spinoto.com) ───────────────────────────────

# Shared secret for the machine-to-machine webhook
# POST /api/integrations/booking-orders (x-api-key header).
# The endpoint fails closed with 503 while this is unset. Never reuse this
# value for anything else.
BOOKING_WEBHOOK_KEY=

# Razorpay. Leave BOTH blank to run the booking flow in simulated-payment mode:
# create-order then returns key_id 'rzp_test_mock' and the SPA runs its fake
# checkout, so the whole funnel is testable before the merchant account exists.
# ⚠ RAZORPAY_KEY_SECRET must NEVER be sent to a browser. Only key_id is public.
# ── HOW MANY PROXIES SIT IN FRONT OF THIS SERVER ─────────────────────────────
# A HOP COUNT, not a boolean. Every rate limit is keyed on req.ip, and req.ip is
# only the real caller when Express knows the chain length.
#
#   unset / 0  no proxy — req.ip is the socket address and any X-Forwarded-For
#              a caller sends is ignored. Correct for a directly-exposed server.
#   1          one trusted hop (Render, Railway, Fly, a single nginx).
#   2          e.g. Cloudflare in front of a platform proxy.
#
# ⚠ Too HIGH is the dangerous direction: Express then reads an address the CALLER
#   supplied, and one caller can occupy unlimited rate buckets by varying it —
#   which defeats the card-testing guard on the public pay endpoint. Too LOW just
#   means everyone shares one bucket: safe, and obvious.
TRUST_PROXY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Signs the collections webhook (payment.captured, refund.processed, …). Without
# it that endpoint refuses every delivery — see webhooks.payments.controller.js.
RAZORPAY_WEBHOOK_SECRET=

# ── PAYING HUBS (RazorpayX) ───────────────────────────────────────────────────
# A DIFFERENT PRODUCT from the keys above, with separate onboarding and its own
# credentials. The Razorpay keys will not work here, and there is deliberately no
# fallback to them: a payout signed with the collections account either fails or,
# worse, draws on the wrong balance.
#
# ⚠ With these unset the payout adapter runs in MOCK MODE, and mock mode reports
#   every transfer as PROCESSED. On a staging server with real hub data that
#   means every purchase invoice reads PAID with not one rupee moved. Mock ids
#   are prefixed pout_mock_ — check that before believing a payout screen.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
# The source bank account payouts are drawn FROM. Required — RazorpayX takes it
# on every transfer, and treating a missing one as "configured" would move the
# failure from boot to the moment somebody presses Pay.
RAZORPAYX_ACCOUNT_NUMBER=
# Signs the payout webhook. NOT optional in practice: payout status arrives ONLY
# by webhook — there is no browser callback for money leaving — so without this
# every transfer stays 'queued' for ever and no invoice is ever marked paid.
# requestPayout() refuses to send money while it is unset.
RAZORPAYX_WEBHOOK_SECRET=

# OTP delivery. A generic outbound webhook, so any SMS vendor plugs in without
# a code change; it receives { mobile, message, template }.
# ⚠ While this is unset, EVERY OTP is the fixed code below and anyone can
#   verify any mobile number. Set it before taking real bookings.
SMS_WEBHOOK_URL=
BOOKING_OTP_FIXED=1234
BOOKING_OTP_TTL_MIN=10
BOOKING_OTP_MAX_ATTEMPTS=5

# How long the post-OTP booking_token stays valid (zeit/ms format).
BOOKING_TOKEN_TTL=30m

# Serviceability gate for GET /api/public/booking/check-location.
# Comma-separated pincode PREFIXES, e.g. "38,39". Leave blank to accept every
# location — the hubs table carries no coordinates yet, so a radius check is
# not possible and this prefix list is the only gate available.
BOOKING_SERVICE_PINCODES=

# ─── Customer-facing links ───────────────────────────────────────────────────

# The origin customers see, e.g. https://app.spinoto.in — no trailing slash.
#
# Used by utils/qr.js to build the invoice share link that goes in the QR code
# and in the WhatsApp invoice template. utils/qr.js:44 falls back to the
# REQUESTING app's Origin when this is unset, which in production would bake an
# internal hostname into a customer's printed invoice. The public document
# endpoint passes no fallback at all, so unset here means simply no QR.
PUBLIC_APP_URL=

# ─── WhatsApp (Interakt) ─────────────────────────────────────────────────────

# From app.interakt.ai → Settings → Developer Settings.
# Sent as `Authorization: Basic <key>` — it is ALREADY base64, do not re-encode.
# ⚠ A secret. Never commit it, never send it to a browser, never log it.
#   While unset, the outbox queues messages and the worker sends nothing —
#   deliberately fail-closed, so a missing key cannot become silent success.
INTERAKT_API_KEY=

# Shared secret Interakt must send back on POST /api/whatsapp/webhook.
# Unset = the webhook rejects everything, rather than trusting any caller that
# can reach the URL.
INTERAKT_WEBHOOK_SECRET=

# Where test sends from Settings → WhatsApp go. A 10-digit Indian mobile.
# Exists because Interakt has no API to read a template's variable order, so the
# only way to catch a mis-transcribed mapping is to send one to yourself first.
WHATSAPP_TEST_NUMBER=

# ─────────────────────────────────────────────────────────────────────────────
# Postgres TLS  (src/config/pgssl.js — used by the app AND by db/migrate.js)
# ─────────────────────────────────────────────────────────────────────────────
# TLS is decided by the HOST, not by NODE_ENV:
#   • sslmode= in DATABASE_URL wins if present
#   • otherwise: on in production, UNLESS the host is localhost/127.0.0.1
#
# Postgres on the same droplet   → nothing to set. TLS stays off, correctly.
# DO Managed Postgres            → put ?sslmode=require on DATABASE_URL, then
#                                  download ca-certificate.crt from the cluster
#                                  panel and point PGSSL_CA_PATH at it.
PGSSL_CA_PATH=
# Escape hatch: TLS on, certificate NOT verified. Works, and drops MITM
# protection — use it to get unblocked, not to stay.
PGSSL_NO_VERIFY=

# ─────────────────────────────────────────────────────────────────────────────
# Production safety switches — leave BOTH unset
# ─────────────────────────────────────────────────────────────────────────────
# Without SMS_WEBHOOK_URL there is no way to deliver a real OTP, so in
# production the booking endpoint refuses to send one. Set this to 'true' only
# if you genuinely want every booking OTP to be BOOKING_OTP_FIXED — which means
# anyone can verify anybody's mobile number.
BOOKING_OTP_ALLOW_FIXED=
# Without RazorpayX credentials the payout adapter can fake a successful
# payout. In production it refuses instead. Set this to 'true' only to exercise
# the flow deliberately: it reports money as sent without sending any.
PAYOUT_ALLOW_MOCK=

# ─────────────────────────────────────────────────────────────────────────────
# Web push (topbar + phone notifications). Unset = push silently disabled.
# Generate once with:  npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# ImageKit — hub & workshop document/photo upload.
# Unset is fine: uploads fall back to local disk under /uploads.
# ─────────────────────────────────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# PDF rendering (Puppeteer/Chrome). On a 1 GiB droplet the default of 3
# concurrent renders will get the process OOM-killed. Set it to 1 there.
# ─────────────────────────────────────────────────────────────────────────────
PDF_MAX_CONCURRENT=
PDF_QUEUE_TIMEOUT_MS=
PDF_RENDER_TIMEOUT_MS=

# Which gateway adapter to use. Defaults: razorpay / razorpayx.
PAYMENT_GATEWAY=
PAYOUT_GATEWAY=
PAYMENT_LINK_TTL_DAYS=
PUBLIC_API_BASE_URL=
APP_URL=
FRONTEND_URL=
